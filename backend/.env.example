# Ключ Claude API — https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Модель, используемая для извлечения скиллов и сравнения с вакансией
ANTHROPIC_MODEL=claude-sonnet-5

# Строка подключения к БД. Для старта достаточно SQLite,
# для продакшена можно заменить на postgresql+psycopg2://user:pass@host/db
DATABASE_URL=sqlite:///./jobrate.db
